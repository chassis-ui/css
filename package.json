{
  "name": "chassis-css-workspace",
  "private": true,
  "description": "Workspace of @chassis-ui/css and its documentation site",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/chassis-ui/css.git"
  },
  "author": "Ozgur Gunes <o.gunes@gmail.com>",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "build": "pnpm dist && pnpm site:build",
    "start": "pnpm dist && pnpm vendor && pnpm dev",
    "dev": "run-p watch astro:dev",
    "dist": "pnpm --filter @chassis-ui/css run dist",
    "test": "pnpm check:code && pnpm dist && pnpm css:test && pnpm css:test:tailwind && pnpm js:test:unit && pnpm site:build && pnpm site:lint",
    "test:ci": "pnpm lint:prettier && pnpm css:lint && pnpm js:lint && pnpm js:typecheck && pnpm build:test && pnpm verify && pnpm css:test && pnpm css:test:tailwind && pnpm js:test:e2e:tailwind-parity && pnpm js:test:unit:all-browsers && pnpm js:test:e2e && pnpm js:test:a11y && pnpm js:test:integration && pnpm check:package && pnpm check:astro && pnpm site:build && pnpm site:lint && pnpm docs:links && pnpm check:bundle && pnpm check:pnpm",
    "build:test": "node --test \"build/tests/*.test.mjs\"",
    "lint:prettier": "prettier -c --cache .",
    "css": "pnpm --filter @chassis-ui/css run css",
    "css:compile": "pnpm --filter @chassis-ui/css run css:compile",
    "css:lint": "run-p css:lint:stylelint css:lint:vars css:lint:tailwind css:lint:imports",
    "css:lint:tailwind": "pnpm --filter @chassis-ui/css run css:lint:tailwind",
    "css:lint:imports": "node build/check-imports.js packages/css/scss/ packages/site/src/scss/",
    "css:lint:stylelint": "stylelint \"**/*.{css,scss}\" \"!vendor/**\" --cache --cache-location .cache/.stylelintcache",
    "css:lint:vars": "fusv packages/css/scss/ packages/site/src/scss/",
    "css:minify": "pnpm --filter @chassis-ui/css run css:minify",
    "css:prefix": "pnpm --filter @chassis-ui/css run css:prefix",
    "css:tailwind": "pnpm --filter @chassis-ui/css run css:tailwind",
    "css:tailwind:update-clashes": "pnpm --filter @chassis-ui/css run css:tailwind:update-clashes",
    "css:tailwind:update-clash-policy": "pnpm --filter @chassis-ui/css run css:tailwind:update-clash-policy",
    "css:test": "pnpm --filter @chassis-ui/css run css:test",
    "css:test:tailwind": "pnpm --filter @chassis-ui/css run css:test:tailwind",
    "js": "pnpm --filter @chassis-ui/css run js",
    "js:compile": "pnpm --filter @chassis-ui/css run js:compile",
    "js:emit-types": "pnpm --filter @chassis-ui/css run js:emit-types",
    "js:lint": "eslint --cache --cache-location .cache/.eslintcache --report-unused-disable-directives --ext .html,.js,.ts,.cjs,.mjs,.md .",
    "js:minify": "pnpm --filter @chassis-ui/css run js:minify",
    "js:test:a11y": "pnpm --filter @chassis-ui/css run js:test:a11y",
    "js:test:debug": "pnpm --filter @chassis-ui/css run js:test:debug",
    "js:test:e2e": "pnpm --filter @chassis-ui/css run js:test:e2e",
    "js:test:e2e:tailwind-parity": "pnpm --filter @chassis-ui/css run js:test:e2e:tailwind-parity",
    "js:test:e2e:ui": "pnpm --filter @chassis-ui/css run js:test:e2e:ui",
    "js:test:integration": "pnpm --filter @chassis-ui/css run js:test:integration",
    "js:test:integration:package": "pnpm --filter @chassis-ui/css run js:test:integration:package",
    "js:test:unit": "pnpm --filter @chassis-ui/css run js:test:unit",
    "js:test:unit:all-browsers": "pnpm --filter @chassis-ui/css run js:test:unit:all-browsers",
    "js:typecheck": "pnpm --filter @chassis-ui/css run js:typecheck",
    "site": "pnpm site:build && pnpm site:lint",
    "site:build": "pnpm vendor && pnpm astro:build && pnpm site:pagefind",
    "site:clean": "rm -rf _site packages/site/node_modules packages/site/.astro packages/site/public",
    "site:lint": "pnpm site:lint:eslint && pnpm site:lint:prettier && pnpm site:lint:vnu && pnpm site:lint:html && pnpm site:lint:links",
    "site:lint:eslint": "eslint packages/site --cache --cache-location .cache/.eslintcache --report-unused-disable-directives",
    "site:lint:prettier": "prettier -c --cache packages/site",
    "site:lint:vnu": "pnpm --filter chassis-css-site run lint:vnu",
    "site:lint:links": "node build/check-links.mjs --site",
    "site:lint:html": "pnpm --filter chassis-css-site run lint:html",
    "site:pagefind": "pagefind --site _site --output-subdir css/pagefind",
    "astro:build": "pnpm --filter chassis-css-site run build",
    "astro:dev": "pnpm --filter chassis-css-site run dev",
    "astro:preview": "pnpm --filter chassis-css-site run preview",
    "release:sri": "node build/generate-sri.js",
    "release:zip": "pnpm --filter @chassis-ui/css run release:zip",
    "watch": "run-p watch:css:main watch:css:site watch:css:test watch:js:main watch:js:site",
    "watch:css:main": "nodemon --watch packages/css/scss/ --ext scss --exec \"pnpm css:lint; pnpm css:compile && pnpm css:prefix && pnpm css:tailwind\"",
    "watch:css:site": "nodemon --watch packages/site/src/scss/ --ext scss --exec \"pnpm css:lint\"",
    "watch:css:test": "nodemon --watch packages/css/scss/ --ext scss,js --exec \"pnpm css:test\"",
    "watch:js:main": "nodemon --watch packages/css/js/src/ --ext ts --exec \"pnpm js:lint && pnpm js:compile\"",
    "watch:js:site": "nodemon --watch packages/site/src/assets/ --ext js --exec \"pnpm js:lint\"",
    "bundlewatch:fix": "pnpm --filter @chassis-ui/css run bundlewatch:fix",
    "bundlewatch:table": "pnpm --filter @chassis-ui/css run bundlewatch:table",
    "check": "run-p check:bundle check:code check:pnpm",
    "check:astro": "pnpm --filter chassis-css-site run check",
    "check:bundle": "pnpm --filter @chassis-ui/css run check:bundle",
    "check:code": "run-p css:lint js:lint site:lint",
    "check:package": "pnpm --filter @chassis-ui/css run check:package",
    "check:pnpm": "pnpm audit --prod --audit-level moderate",
    "verify": "pnpm --filter @chassis-ui/css run verify",
    "docs:links": "node build/check-links.mjs",
    "changeset": "changeset",
    "changeset:version": "changeset version && node build/sync-version-refs.js",
    "sync-submodules": "pnpm --filter chassis-css-site exec chassis-docs sync-submodules",
    "vendor": "pnpm --filter chassis-css-site exec chassis-docs vendor"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@eslint/markdown": "^8.0.3",
    "cspell": "^10.3.5",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-astro": "^2.1.1",
    "eslint-plugin-html": "^8.2.1",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-unicorn": "^70.0.0",
    "find-unused-sass-variables": "^6.2.1",
    "github-slugger": "^2.0.0",
    "globals": "^17.12.0",
    "nodemon": "^3.1.14",
    "npm-run-all2": "^9.0.3",
    "pagefind": "^1.5.2",
    "prettier": "^3.9.9",
    "prettier-plugin-astro": "^0.14.1",
    "shelljs": "^0.10.0",
    "stylelint": "^16.26.1",
    "stylelint-config-twbs-bootstrap": "^16.1.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0"
  },
  "packageManager": "pnpm@10.33.2+sha512.a90faf6feeab71ad6c6e57f94e0fe1a12f5dcc22cd754db40ae9593eb6a3e0b6b12e3540218bb37ae083404b1f2ce6db2a4121e979829b4aff94b99f49da1cf8",
  "pnpm": {
    "overrides": {
      "axios@^0.31.1": "^0.33.0",
      "brace-expansion@^1": "^1.1.18",
      "brace-expansion@^5": "^5.0.9",
      "colord": "^2.9.4",
      "devalue": "^5.9.2",
      "fast-uri": "^3.1.6",
      "image-size": "^2.0.3",
      "smol-toml": "^1.7.1"
    }
  }
}
