    {
      "name": "border",
      "remedy": "documented",
      "note": "Chassis sets the border shorthand, which resets style/width/color together; it always supersedes Tailwind core border-style/border-width regardless of declaration order."
    },
    {
      "name": "border-0",
      "remedy": "documented",
      "note": "Same as border: the shorthand always wins over Tailwind core border-style/border-width."
    },
