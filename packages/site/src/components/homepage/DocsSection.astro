---
import FeatureCard from '@chassis-ui/docs/components/FeatureCard.astro'
import { getDocsPath } from '@chassis-ui/docs/site'
---

<section class="home-section py-3xl md:py-6xl">
  <div class="container 2xl section-content">
    <div class="grid mb-3xl md:mb-6xl">
      <header class="section-header col-span-full lg:col-span-10 lg:col-start-2 xl:col-span-8 xl:col-start-3 text-center">
        <h2 class="section-title font-3xl md:font-4xl lg:font-5xl mb-xs md:mb-sm lg:mb-md">
          <span class="font-normal d-block">How to</span> Get Started?
        </h2>
        <p class="section-body md:font-lg lg:font-xl m-0">
          Complete documentation covering installation, configuration, components, utilities,
          customization, and integration guides for all major frameworks and build tools.
        </p>
      </header>
    </div>

    <div class="section-features grid grid-cols-1 md:grid-cols-3 gap-md md:gap-xl">
      <div>
        <FeatureCard icon="cx-rocket">
          <Fragment slot="title">Quick Start</Fragment>
          <Fragment slot="body">
            Get up and running in minutes with our step-by-step guides covering installation, setup,
            and your first components.
          </Fragment>
          <ul class="list-unstyled d-flex flex-column gap-xs">
            <li>
              <a href={getDocsPath('/getting-started/what-is-chassis/')}>What is Chassis?</a>
            </li>
            <li>
              <a href={getDocsPath('/getting-started/quick-start/')}>Quick Start</a>
            </li>
            <li>
              <a href={getDocsPath('/getting-started/installation/')}>Installation</a>
            </li>
            <li>
              <a href={getDocsPath('/getting-started/clone-customize/')}>Clone &amp; Customize</a>
            </li>
          </ul>
        </FeatureCard>
      </div>
      <div>
        <FeatureCard icon="cx-rectangles-mixed">
          <Fragment slot="title">Components</Fragment>
          <Fragment slot="body">
            Browse our library of production-ready components with live examples, code snippets, and
            customization options.
          </Fragment>
          <ul class="list-unstyled d-flex flex-column gap-xs">
            <li>
              <a href={getDocsPath('/components/accordion/')}>Accordion</a>
            </li>
            <li>
              <a href={getDocsPath('/components/button/')}>Button</a>
            </li>
            <li>
              <a href={getDocsPath('/components/card/')}>Card</a>
            </li>
            <li>
              <a href={getDocsPath('/components/modal/')}>Modal</a>
            </li>
          </ul>
        </FeatureCard>
      </div>
      <div>
        <FeatureCard icon="cx-book">
          <Fragment slot="title">Resources</Fragment>
          <Fragment slot="body">
            Deep dive into utilities, layout systems, and customization options to build exactly
            what you need.
          </Fragment>
          <ul class="list-unstyled d-flex flex-column gap-xs">
            <li>
              <a href={getDocsPath('/utilities/api/')}>Utilities</a>
            </li>
            <li>
              <a href={getDocsPath('/layout/breakpoints/')}>Layout</a>
            </li>
            <li>
              <a href={getDocsPath('/customize/overview/')}>Customize</a>
            </li>
            <li>
              <a href="https://github.com/chassis-ui/css" target="_blank" rel="noopener">
                GitHub Repository
              </a>
            </li>
          </ul>
        </FeatureCard>
      </div>
    </div>

    <div class="d-flex gap-md justify-content-center mt-3xl md:mt-6xl">
      <a href={getDocsPath('/getting-started/overview/')} class="button primary lg">
        Get Started
      </a>
      <a href={getDocsPath('/')} class="button default lg">
        View Documentation
      </a>
    </div>
  </div>
</section>
