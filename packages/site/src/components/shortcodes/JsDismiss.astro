---
import Code from '@chassis-ui/docs/shortcodes/Code.astro'
import Callout from '@chassis-ui/docs/shortcodes/Callout.astro'

interface Props {
  name: string
  /**
   * The event to listen for, without its namespace.
   * @default 'closed'
   */
  event?: string
}

const { name, event = 'closed' } = Astro.props
const eventName = `${event}.cx.${name}`
---

<p>
  Enable dismissal with the <code>data-cx-dismiss</code> attribute on a button{' '}
  <strong>within the {name}</strong>:
</p>

<Code
  code={`<button type="button" class="close-button" data-cx-dismiss="${name}" aria-label="Dismiss"></button>`}
  lang="html"
/>

<p>
  Or on a button <strong>outside the {name}</strong> using the additional{' '}
  <code>data-cx-target</code> attribute:
</p>

<Code
  code={`<button type="button" class="close-button" data-cx-dismiss="${name}" data-cx-target="#my-${name}" aria-label="Dismiss ${name}"></button>`}
  lang="html"
/>

<Callout type="warning">
  When a {name} is dismissed, it is completely removed from the DOM. To keep focus management
  accessible, set focus to an appropriate element in a listener of the
  <code>{eventName}</code> event.
</Callout>
