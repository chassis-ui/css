{
  "name": "chassis-css-site",
  "private": true,
  "description": "Documentation site of Chassis CSS",
  "type": "module",
  "scripts": {
    "dev": "astro dev --port 4323 --host",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "lint:html": "chassis-docs html-validate ../../_site ../css/js/tests --config html-validate.json",
    "lint:vnu": "chassis-docs vnu ../../_site ../css/js/tests --filter-file vnu-filters.txt",
    "clean": "rm -rf .astro public"
  },
  "devDependencies": {
    "@chassis-ui/css": "workspace:*",
    "@astrojs/check": "^0.9.10",
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/mdx": "^8.0.2",
    "@astrojs/sitemap": "^3.7.4",
    "@chassis-ui/docs": "^0.6.3",
    "@chassis-ui/icons": "^0.3.1",
    "@chassis-ui/tokens": "^0.7.0",
    "@floating-ui/dom": "^1.8.0",
    "@pagefind/component-ui": "^1.5.2",
    "@shikijs/transformers": "^4.5.0",
    "@stackblitz/sdk": "^1.11.1",
    "@types/node": "^26.6.4",
    "astro": "^7.3.5",
    "autoprefixer": "^10.6.1",
    "culori": "^4.0.2",
    "html-validate": "11.16.1",
    "htmlparser2": "^12.0.0",
    "postcss": "^8.5.28",
    "postcss-prefix-custom-properties": "^0.1.0",
    "rehype-autolink-headings": "^7.1.0",
    "sass": "^1.105.1",
    "shiki": "^4.5.0",
    "typescript": "^6.0.3",
    "vnu-jar": "^26.10.2"
  }
}
